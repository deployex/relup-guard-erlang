{erl_opts, [debug_info]}.
{deps, []}.

%% Pinned, not left floating: this exact plugin version has real quirks
%% this project's own scripts work around (a supervisor-child-diffing
%% crash on a plain init/1 child-spec list, undocumented
%% --previous/--current flag requirements) - an unpinned version could
%% silently pick up a newer release that changes that behavior again,
%% in ways CI wouldn't catch until a run actually failed.
{plugins, [{rebar3_appup_plugin, "2.4.11"}]}.

{relx, [
    {release, {relup_demo, "0.1.0"}, [
        relup_demo,
        sasl
    ]},

    {mode, dev},

    %% automatically picked up if the files
    %% exist but can be set manually, which
    %% is required if the names aren't exactly
    %% sys.config and vm.args
    {sys_config, "./config/sys.config"},
    {vm_args, "./config/vm.args"}

    %% the .src form of the configuration files do
    %% not require setting RELX_REPLACE_OS_VARS
    %% {sys_config_src, "./config/sys.config.src"},
    %% {vm_args_src, "./config/vm.args.src"}
]}.

{profiles, [
    %% prod is the default mode when prod
    %% profile is used, so does not have
    %% to be explicitly included like this
    {prod, [
        {relx, [
            {mode, prod}

            %% use minimal mode to exclude ERTS
            %% {mode, minimal}
        ]}
    ]}
]}.
